// British vegetation (the Weston-super-Mare map and the ?scene=uktrees gallery): wind, LOD and the per-archetype tables.
// The same LOD system as veg_common.wgsl (the Serra da Mata's, which this file leaves alone). The tables (VEG_NT, VEG_SP,
// VEG_H, VEG_UKV, VEG_NA_UK) are generated by 33_veg_e_uk.js into the include veg_uk_tables from its species list.
#include palette
#include veg_uk_tables
const VEG_D0 = 90.0;   // mesh → impostor switch (m, effective distance)
const VEG_D1 = 112.0;
const VEG_U0 = 60.0;   // the near-only plants (ground cover, ferns, marram) fade out between U0 and U1
const VEG_U1 = 80.0;
const VEG_L0 = 26.0;   // individual leaves shrink away between L0 and L1
const VEG_L1 = 38.0;
fn vegZoom() -> f32 { return clamp(F.post.y * 2.0, 0.3, 1.25); }
fn vegFade(dEff: f32, seed: f32, d0: f32, d1: f32) -> f32 { let a = mix(d0, d1, fract(seed * 7.31 + 0.13)); return step(a, dEff); }
// wind displacement of a point of the plant (see veg_common.wgsl). base = foot; rel = point relative to the foot (m);
// w = branch weight (0 trunk .. 1 tip); fl = leaf flutter weight; ph = leaf phase (0..1). k = species flutter (birch and
// aspen-like leaves on long stalks tremble more; pines and holm oak hardly at all).
fn vegWindK(base: vec3f, rel: vec3f, w: f32, fl: f32, ph: f32, time: f32, k: f32) -> vec3f {
  let W = vec3f(F.wind.x, 0.0, F.wind.y); let S = F.wind.z; let X = vec3f(-F.wind.y, 0.0, F.wind.x);
  let p0 = base.x * 0.031 + base.z * 0.047;
  let gust = 0.55 + 0.45 * sin(time * 0.43 + p0) * sin(time * 0.71 + p0 * 1.7 + 1.3);
  let hb = rel.y * 0.05;
  var d = W * (hb * hb) * (0.16 + 0.34 * gust + 0.07 * sin(time * 1.31 + p0 * 3.0));
  let p1 = p0 * 5.0 + dot(rel, vec3f(0.37, 0.29, 0.41));
  d += (W * (0.35 * gust + 0.65 * sin(time * 1.7 + p1)) + X * 0.6 * sin(time * 2.3 + p1 * 1.3) + vec3f(0.0, 0.45, 0.0) * sin(time * 2.9 + p1 * 0.7)) * (w * w * 0.16);
  let p2 = ph * 40.0 + dot(rel, vec3f(2.1, 1.7, 2.6));
  d += (X * sin(time * 6.3 + p2) + vec3f(0.0, 0.7, 0.0) * sin(time * 7.9 + p2 * 1.4) + W * 0.5 * sin(time * 5.1 + p2 * 0.6)) * (fl * 0.035 * k * (0.5 + 0.8 * gust));
  return d * S;
}
fn vegNoise(px: vec2f) -> f32 { return hash21(px + vec2f(F.misc.y * 17.13, F.misc.y * 31.71)); }
fn vegCover(a: f32, thr: f32) -> f32 { return sat((a - thr) / clamp(fwidth(a), 0.02, 0.7) + 0.5); }
fn ukArch(arch: f32) -> u32 { return u32(clamp(arch, 0.0, f32(VEG_NA_UK - 1u))); }
// Per-tree tint: a British summer canopy varies far less than a rainforest's. Each species has its colour (VEG_SP) and
// a variation amplitude (VEG_UKV.x); a few trees are darker or a touch yellower, and the odd one is starting to turn
// (VEG_UKV.y: the share of trees with an early-autumn tinge, e.g. horse chestnuts browned by leaf miners in August).
fn vegTintA(seed: f32, arch: f32) -> vec3f {
  let ai = ukArch(arch); let v = VEG_UKV[ai];
  let a = fract(seed * 13.37 + 0.21); let b = fract(seed * 5.71 + 0.63); let l = fract(seed * 29.3 + 0.4);
  var c = mix(vec3f(0.9, 0.95, 0.9), vec3f(1.1, 1.05, 0.86), a);            // bluer ↔ yellower green
  c = mix(c, vec3f(0.8, 0.84, 0.8), smoothstep(0.8, 0.95, b));               // darker crowns (~12%)
  c = mix(vec3f(1.0), c, v.x);
  c = mix(c, vec3f(1.35, 0.98, 0.55), smoothstep(1.0 - v.y, 1.0 - v.y * 0.3, fract(seed * 3.17 + 0.5)) * 0.75);   // turning
  return c * (1.0 + (l - 0.5) * 0.3 * v.x) * VEG_SP[ai];
}
#ifdef PASS_SHADOW
// (see veg_common.wgsl)
fn vegShadowCull(base: vec3f, h: f32) -> bool {
  let slot = P.camPos.w; if (slot > 3.5) { return false; }
  let lp = P.viewProj * vec4f(base + vec3f(0.0, h * 0.5, 0.0), 1.0);
  let inv = length(vec3f(P.viewProj[0][0], P.viewProj[1][0], P.viewProj[2][0]));
  let m = (h * 0.75 + 5.0) * inv;
  return abs(lp.x) > 1.0 + m || abs(lp.y) > 1.0 + m || lp.z > 1.02 || lp.z < -0.08;
}
fn vegShadowMesh(base: vec3f, fade: f32) -> bool {
  let slot = P.camPos.w; if (slot > 2.5 || fade >= 0.5) { return false; }
  let lp = P.viewProj * vec4f(base, 1.0);
  let inv = length(vec3f(P.viewProj[0][0], P.viewProj[1][0], P.viewProj[2][0]));
  let zr = 1.0 / max(length(vec3f(P.viewProj[0][2], P.viewProj[1][2], P.viewProj[2][2])), 1e-6);
  return abs(lp.x) < 1.0 + 20.0 * inv && abs(lp.y) < 1.0 + 20.0 * inv && (1.0 - lp.z) * zr < 2.0 / inv + 75.0;
}
#endif
